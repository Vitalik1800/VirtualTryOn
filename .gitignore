.idea/
.vscode/

# Operating System
.DS_Store
Thumbs.db

# Logs
*.log

# Output
output/*
!output/.gitkeep

# Temporary files
*.tmp
*.bak

# Jupyter
.ipynb_checkpoints/

# Environment
.env

# Coverage
.coverage
htmlcov/

# Test reports
test-results/